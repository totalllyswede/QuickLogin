<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="QuickLogin.HelpWindow"
        Title="Help"
        Height="470"
        Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderThickness="30"
        BorderBrush="#801A1A2E"
        Background="#DD1A1A2E"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="CloseButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="17.5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="0,-2,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A93226"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <!-- Close button -->
        <Button Content="✕" 
                Style="{StaticResource CloseButton}"
                Click="Close_Click"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,5,5,0"
                Panel.ZIndex="2"/>

        <!-- Content -->
        <Grid Margin="30,10,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Quick Start Guide"
                       FontFamily="Segoe UI Light"
                       FontSize="26"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>
            <Grid Grid.Row="1"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,-52">

                    <!-- Step 1 -->
                    <Border Background="#2E2E48" 
                        CornerRadius="8" 
                        Padding="15,12" 
                        Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI Semibold"
                                FontSize="15"
                                Foreground="#14FFEC"><Run Text="1. "/><Run Text=" "/><Run Text="Add Your Account"/></TextBlock>
                            <TextBlock Text="Click '+ Add Account' and enter your credentials"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                Foreground="#B0B0B0"
                                Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 2 -->
                    <Border Background="#2E2E48" 
                        CornerRadius="8" 
                        Padding="15,12" 
                        Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI Semibold"
                                FontSize="15"
                                Foreground="#14FFEC"><Run Text="2. "/><Run Text=" "/><Run Text="Optional: Auto-Launch"/></TextBlock>
                            <TextBlock Text="Browse for Wow.exe and enable auto-launch checkbox"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                Foreground="#B0B0B0"
                                Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 3 -->
                    <Border Background="#2E2E48" 
                        CornerRadius="8" 
                        Padding="15,12" 
                        Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI Semibold"
                                FontSize="15"
                                Foreground="#14FFEC"><Run Text="3. "/><Run Text=" "/><Run Text="Login"/></TextBlock>
                            <TextBlock Text="Select account and click 'Login' or 'Login &amp; Close'"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                Foreground="#B0B0B0"
                                Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Important Warning -->
                    <Border Background="#3D2020" 
                        BorderBrush="#E74C3C"
                        BorderThickness="2"
                        CornerRadius="8" 
                        Padding="15,12" 
                        Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI Semibold"
                                FontSize="14"
                                Foreground="#E74C3C"
                                Text="⚠ Important" HorizontalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap"
                                FontFamily="Segoe UI"
                                FontSize="12"
                                Foreground="#E4E4E4"
                                Margin="0,5,0,0" HorizontalAlignment="Center"><Run Text="Uncheck 'Remember Account Name' on WoW login screen"/><LineBreak/><Run Text="Passwords stored securely in Windows Credential Manager"/></TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

            <!-- Simplified Content -->
        </Grid>
    </Grid>
</Window>